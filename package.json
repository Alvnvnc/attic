{
  "name": "attic",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Attic \u2014 ambient household memory for Alexa+, exposed as a self-hosted MCP server over Streamable HTTP.",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "npm run build -w mcp-trace && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "node dist/db/seed.js --reset",
    "test": "npm run build && node --test packages/mcp-trace/dist/*.test.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "zod": "^3.25.76",
    "mcp-trace": "0.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.9.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
