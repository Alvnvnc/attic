{
  "name": "mcp-trace",
  "version": "0.1.0",
  "description": "Record MCP JSON-RPC traffic in both directions for any Streamable HTTP server, with zero dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "streamable-http",
    "json-rpc",
    "tracing",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alvnvnc/mcp-trace.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.2"
  }
}
