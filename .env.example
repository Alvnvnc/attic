# Attic — local development
PORT=8787
ATTIC_DB=./data/attic.db
ATTIC_MCP_TOKEN=change-me-before-deploying
ATTIC_HOUSE_NAME=Casa Wibowo

# The MCP client inside the app talks to this server.
ATTIC_MCP_URL=http://127.0.0.1:8787/mcp

# Any OpenAI-compatible chat-completions endpoint with tool calling.
ATTIC_LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
ATTIC_LLM_MODEL=glm-4.5-flash
ATTIC_LLM_API_KEY=

# Set to 1 to run the MCP endpoint without a bearer token (local demos only).
# ATTIC_OPEN_MCP=0
